{%- comment -%}
  Kleine bewegte Szenen fuer die Produktgeschichte (sections/gf-geschichte.liquid).
  Strichzeichnungen in Waldgruen auf Salbei, Bewegung in assets/gf-geschichte.css.
  Jede Szene zeigt nur, was die Beschreibung sagt, nichts dazuerfunden.

  Namen: nacht, obgrashtane, hlad, vazduh, obrashtane, prujini, partnyor, zashtita, lavandula,
         valna, bebe, gragnak, masaj, bambuk, cip, toper, plat, sezoni, sloeve
  "sloeve" zeichnet den Schichtaufbau aus snippets/gf-schichten-daten.liquid (oder Metafeld
  custom.schichten) als kleinen Stapel, der sich Schicht fuer Schicht aufbaut.

  Aufruf: {% render 'gf-szene', name: 'nacht', product: product %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'nacht' -%}
    <svg class="gf-s gf-s-nacht" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-mond"><path d="M176 26a24 24 0 1 0 20 38 19 19 0 1 1-20-38Z" fill="var(--gf-wald)"/></g>
      <g fill="var(--gf-wald)">
        <circle class="gf-s-stern" cx="62" cy="34" r="2.4" style="--i:0"/>
        <circle class="gf-s-stern" cx="104" cy="22" r="1.8" style="--i:1"/>
        <circle class="gf-s-stern" cx="132" cy="52" r="2.2" style="--i:2"/>
        <circle class="gf-s-stern" cx="40" cy="70" r="1.6" style="--i:3"/>
        <circle class="gf-s-stern" cx="212" cy="88" r="1.8" style="--i:4"/>
      </g>
      <g class="gf-s-z" fill="var(--gf-wald)" font-family="Montserrat, sans-serif" font-weight="600">
        <text x="92" y="98" font-size="13" style="--i:0">z</text>
        <text x="102" y="86" font-size="16" style="--i:1">z</text>
        <text x="114" y="72" font-size="19" style="--i:2">z</text>
      </g>
      <rect x="34" y="120" width="172" height="24" rx="9" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <rect x="44" y="106" width="44" height="16" rx="8" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <path class="gf-s-decke" d="M80 122c10-14 34-16 52-10s40 4 52-4c10-6 18 2 20 14Z" fill="var(--gf-salbei-tief)" stroke="var(--gf-wald)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M44 144v12M196 144v12" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {%- when 'obgrashtane' -%}
    <svg class="gf-s gf-s-obgrashtane" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-kugel"><circle cx="120" cy="66" r="22" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/><path d="M110 62c3-4 8-6 13-5" fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" opacity=".5"/></g>
      {%- assign tiefen = '0.05,0.15,0.35,0.6,0.7,0.6,0.35,0.15,0.05' | split: ',' -%}
      <g fill="#F3ECDC" stroke="var(--gf-wald)" stroke-width="1.6">
        {%- for t in tiefen -%}
          {%- assign x = forloop.index0 | times: 18 | plus: 39 -%}
          <rect class="gf-s-saeule" x="{{ x }}" y="96" width="18" height="52" rx="3" style="--t:{{ t }}"/>
        {%- endfor -%}
      </g>
      <path d="M30 152h180" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {%- when 'hlad' -%}
    <svg class="gf-s gf-s-hlad" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-flocke" stroke="var(--gf-wald)" stroke-width="2.2" stroke-linecap="round" fill="none">
        <path d="M120 26v52M97.5 39l45 26M97.5 65l45-26"/>
        <path d="M113 30l7 6 7-6M113 74l7-6 7 6M96 47l9 2-3 8M144 47l-9 2 3 8M96 57l9-2-3-8M144 57l-9-2 3-8"/>
      </g>
      <g fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" opacity=".7">
        <path class="gf-s-welle" d="M66 104c-6-6 6-10 0-16s6-10 0-16" style="--i:0"/>
        <path class="gf-s-welle" d="M174 104c-6-6 6-10 0-16s6-10 0-16" style="--i:1"/>
      </g>
      <rect x="36" y="112" width="168" height="36" rx="10" fill="#3F67C2" stroke="var(--gf-wald)" stroke-width="2"/>
      <g fill="#fff" opacity=".55">
        <circle cx="60" cy="124" r="2.2"/><circle cx="84" cy="136" r="1.8"/><circle cx="110" cy="122" r="2"/><circle cx="134" cy="138" r="2.4"/><circle cx="160" cy="124" r="1.8"/><circle cx="186" cy="134" r="2"/>
      </g>
    </svg>

  {%- when 'vazduh' -%}
    <svg class="gf-s gf-s-vazduh" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <rect x="34" y="78" width="172" height="56" rx="12" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <g fill="var(--gf-salbei-tief)">
        {%- for i in (0..6) -%}<circle cx="{{ i | times: 22 | plus: 54 }}" cy="106" r="6"/>{%- endfor -%}
      </g>
      <g fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" stroke-dasharray="7 11">
        <path class="gf-s-luft" d="M8 96c40 0 52 10 112 10s76-12 114-10" style="--i:0"/>
        <path class="gf-s-luft" d="M8 60c40-10 80 6 112 4s70-14 112-6" style="--i:1" opacity=".55"/>
        <path class="gf-s-luft" d="M8 152c44 6 80-6 112-4s76 10 112 2" style="--i:2" opacity=".55"/>
      </g>
    </svg>

  {%- when 'obrashtane' -%}
    <svg class="gf-s gf-s-obrashtane" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-wende">
        <rect x="44" y="70" width="152" height="20" rx="8" fill="#F3ECDC" stroke="var(--gf-wald)" stroke-width="2"/>
        <rect x="44" y="90" width="152" height="20" rx="8" fill="#B8CDB2" stroke="var(--gf-wald)" stroke-width="2"/>
        <path d="M58 80h20M88 80h20M118 80h20M148 80h20" stroke="var(--gf-wald)" stroke-width="1.4" stroke-linecap="round" opacity=".35"/>
        <path d="M52 104q6-8 12 0t12 0 12 0 12 0 12 0 12 0 12 0 12 0 12 0 12 0 12 0" fill="none" stroke="var(--gf-wald)" stroke-width="1.4" opacity=".45"/>
      </g>
      <g class="gf-s-pfeil" fill="none" stroke="var(--gf-wald)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M206 64a40 40 0 0 1 0 52"/><path d="m200 112 6 5 6-6"/>
        <path d="M34 116a40 40 0 0 1 0-52"/><path d="m40 68-6-5-6 6"/>
      </g>
      <path d="M70 140h100" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" opacity=".25"/>
    </svg>

  {%- when 'prujini' -%}
    <svg class="gf-s gf-s-prujini" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <rect x="30" y="146" width="180" height="8" rx="4" fill="var(--gf-wald)" opacity=".2"/>
      {%- for i in (0..6) -%}
        {%- assign x = i | times: 24 | plus: 48 -%}
        <g class="gf-s-feder" style="--i:{{ i }}">
          <path d="M{{ x }} 146l-9-6 18-8-18-8 18-8-18-8 18-8-18-8 9-6" fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
          <rect x="{{ x | minus: 11 }}" y="80" width="22" height="6" rx="3" fill="var(--gf-wald)"/>
        </g>
      {%- endfor -%}
      <circle class="gf-s-druck" cx="120" cy="48" r="16" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
    </svg>

  {%- when 'partnyor' -%}
    <svg class="gf-s gf-s-partnyor" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <ellipse class="gf-s-ring" cx="78" cy="118" rx="34" ry="7" fill="none" stroke="var(--gf-wald)" stroke-width="1.6"/>
      <g class="gf-s-dreht">
        <circle cx="62" cy="88" r="11" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
        <rect x="74" y="84" width="52" height="24" rx="12" fill="var(--gf-salbei-tief)" stroke="var(--gf-wald)" stroke-width="2"/>
      </g>
      <g>
        <circle cx="178" cy="98" r="11" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
        <rect x="114" y="94" width="52" height="16" rx="8" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
        <g class="gf-s-z" fill="var(--gf-wald)" font-family="Montserrat, sans-serif" font-weight="600">
          <text x="186" y="78" font-size="12" style="--i:0">z</text><text x="196" y="66" font-size="15" style="--i:1">z</text>
        </g>
      </g>
      <rect x="30" y="112" width="180" height="26" rx="9" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <path d="M120 116v18" stroke="var(--gf-wald)" stroke-width="1.4" stroke-dasharray="3 4" opacity=".4"/>
    </svg>

  {%- when 'zashtita' -%}
    <svg class="gf-s gf-s-zashtita" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g fill="var(--gf-wald)" opacity=".5">
        <circle class="gf-s-teilchen" cx="64" cy="58" r="3" style="--i:0;--x:-18px;--y:-14px"/>
        <circle class="gf-s-teilchen" cx="178" cy="64" r="2.6" style="--i:1;--x:18px;--y:-12px"/>
        <circle class="gf-s-teilchen" cx="58" cy="122" r="2.4" style="--i:2;--x:-20px;--y:10px"/>
        <circle class="gf-s-teilchen" cx="186" cy="118" r="3" style="--i:3;--x:20px;--y:12px"/>
        <circle class="gf-s-teilchen" cx="120" cy="22" r="2.2" style="--i:4;--x:0px;--y:-16px"/>
      </g>
      <path d="M120 34 82 48v30c0 25 16 44 38 52 22-8 38-27 38-52V48Z" fill="#fff" stroke="var(--gf-wald)" stroke-width="2.4" stroke-linejoin="round"/>
      <path class="gf-s-haken" d="m102 84 13 13 25-27" fill="none" stroke="var(--gf-wald)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
      <path d="M50 152h140" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" opacity=".25"/>
    </svg>

  {%- when 'lavandula' -%}
    <svg class="gf-s gf-s-lavandula" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g fill="#8E7FB8" opacity=".55">
        <circle class="gf-s-duft" cx="112" cy="40" r="3" style="--i:0"/>
        <circle class="gf-s-duft" cx="134" cy="34" r="2.4" style="--i:1"/>
        <circle class="gf-s-duft" cx="148" cy="50" r="2.8" style="--i:2"/>
        <circle class="gf-s-duft" cx="96" cy="54" r="2.2" style="--i:3"/>
      </g>
      <g class="gf-s-zweig">
        <path d="M120 150V70M120 120c-12-6-20-18-22-30M120 110c12-4 20-14 22-26" fill="none" stroke="var(--gf-wald)" stroke-width="2.2" stroke-linecap="round"/>
        <g fill="#8E7FB8" stroke="var(--gf-wald)" stroke-width="1.2">
          <ellipse cx="120" cy="66" rx="5" ry="7"/><ellipse cx="114" cy="76" rx="5" ry="6.5"/><ellipse cx="126" cy="76" rx="5" ry="6.5"/><ellipse cx="114" cy="88" rx="4.6" ry="6"/><ellipse cx="126" cy="88" rx="4.6" ry="6"/>
          <ellipse cx="97" cy="84" rx="4" ry="6"/><ellipse cx="93" cy="94" rx="4" ry="5.5"/><ellipse cx="101" cy="94" rx="4" ry="5.5"/>
          <ellipse cx="143" cy="78" rx="4" ry="6"/><ellipse cx="139" cy="88" rx="4" ry="5.5"/><ellipse cx="147" cy="88" rx="4" ry="5.5"/>
        </g>
      </g>
      <rect x="40" y="148" width="160" height="14" rx="7" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
    </svg>

  {%- when 'valna' -%}
    <svg class="gf-s gf-s-valna" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <path class="gf-s-tropfen" d="M120 24c-8 12-12 18-12 24a12 12 0 0 0 24 0c0-6-4-12-12-24Z" fill="#9CC3E6" stroke="var(--gf-wald)" stroke-width="1.6"/>
      <g fill="#EFE6D6" stroke="var(--gf-wald)" stroke-width="2">
        <circle cx="62" cy="120" r="24"/><circle cx="98" cy="106" r="28"/><circle cx="140" cy="106" r="28"/><circle cx="178" cy="120" r="24"/>
        <rect x="40" y="114" width="160" height="34" rx="14" stroke="none"/>
      </g>
      <path d="M40 148h160" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round"/>
      <g fill="none" stroke="var(--gf-wald)" stroke-width="1.6" stroke-linecap="round" opacity=".55">
        <path class="gf-s-locke" d="M86 112a6 6 0 1 1 8 6" style="--i:0"/><path class="gf-s-locke" d="M128 102a6 6 0 1 1 8 6" style="--i:1"/>
        <path class="gf-s-locke" d="M164 122a6 6 0 1 1 8 6" style="--i:2"/><path class="gf-s-locke" d="M58 126a6 6 0 1 1 8 6" style="--i:3"/>
      </g>
    </svg>

  {%- when 'bebe' -%}
    <svg class="gf-s gf-s-bebe" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-mobile">
        <path d="M120 8v26M92 34h56M92 34v14M148 34v14M120 34v24" stroke="var(--gf-wald)" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <path d="M92 48l3 6 6 1-4.5 4 1 6-5.5-3-5.5 3 1-6-4.5-4 6-1Z" fill="var(--gf-wald)"/>
        <circle cx="148" cy="54" r="6" fill="var(--gf-salbei-tief)" stroke="var(--gf-wald)" stroke-width="1.6"/>
        <path d="M126 58a8 8 0 1 1-6 14 6 6 0 1 0 6-14Z" fill="var(--gf-wald)"/>
      </g>
      <g class="gf-s-atmet">
        <circle cx="86" cy="112" r="13" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
        <path d="M80 112q3 3 6 0M88 112q3 3 6 0" fill="none" stroke="var(--gf-wald)" stroke-width="1.4" stroke-linecap="round"/>
        <rect x="98" y="104" width="62" height="20" rx="10" fill="var(--gf-salbei-tief)" stroke="var(--gf-wald)" stroke-width="2"/>
      </g>
      <path class="gf-s-linie" d="M100 130h56" stroke="var(--gf-wald)" stroke-width="2" stroke-dasharray="2 5" stroke-linecap="round"/>
      <rect x="52" y="126" width="136" height="20" rx="6" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <path d="M44 100v58M196 100v58M44 158h152" fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round"/>
      <path d="M60 100v26M76 100v26M164 100v26M180 100v26" stroke="var(--gf-wald)" stroke-width="1.4" opacity=".35"/>
    </svg>

  {%- when 'gragnak' -%}
    <svg class="gf-s gf-s-gragnak" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      {%- assign sag = '0,7,12,15,15,12,7,0' | split: ',' -%}
      <g fill="#fff" stroke="var(--gf-wald)" stroke-width="2">
        {%- for s in sag -%}
          <rect class="gf-s-wirbel" x="{{ forloop.index0 | times: 20 | plus: 42 }}" y="92" width="16" height="12" rx="5" style="--s:{{ s }}px;--i:{{ forloop.index0 }}"/>
        {%- endfor -%}
      </g>
      <path class="gf-s-gerade" d="M40 98h164" stroke="var(--gf-wald)" stroke-width="1.4" stroke-dasharray="3 5" pathLength="1" opacity=".45"/>
      <rect x="30" y="114" width="180" height="34" rx="10" fill="#E6D6B8" stroke="var(--gf-wald)" stroke-width="2"/>
      <path d="M44 131h152" stroke="var(--gf-wald)" stroke-width="1.2" opacity=".3"/>
    </svg>

  {%- when 'masaj' -%}
    <svg class="gf-s gf-s-masaj" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g fill="#B8CDB2" stroke="var(--gf-wald)" stroke-width="1.8">
        {%- for i in (0..7) -%}
          <ellipse class="gf-s-noppe" cx="{{ i | times: 21 | plus: 46 }}" cy="104" rx="10.5" ry="11" style="--i:{{ i }}"/>
        {%- endfor -%}
        <rect x="35" y="104" width="170" height="40" rx="8"/>
      </g>
      <path d="M36 104h168" stroke="#B8CDB2" stroke-width="3"/>
      <g class="gf-s-hand" fill="none" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 66c10-8 26-8 36 0M78 58v-18"/><path d="m72 46 6-6 6 6"/>
      </g>
    </svg>

  {%- when 'bambuk' -%}
    <svg class="gf-s gf-s-bambuk" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-halm">
        <g fill="var(--gf-salbei-tief)" stroke="var(--gf-wald)" stroke-width="2">
          <rect x="62" y="104" width="16" height="44" rx="5"/><rect x="62" y="60" width="16" height="42" rx="5"/><rect x="62" y="20" width="16" height="38" rx="5"/>
        </g>
        <path d="M78 62c14-10 30-12 40-6-12 8-26 10-40 6ZM62 100c-14-8-26-8-34-2 10 6 22 6 34 2Z" fill="var(--gf-wald)"/>
      </g>
      <g fill="#9CC3E6" stroke="var(--gf-wald)" stroke-width="1.4">
        <path class="gf-s-weg" d="M150 112c-4 6-6 9-6 12a6 6 0 0 0 12 0c0-3-2-6-6-12Z" style="--i:0"/>
        <path class="gf-s-weg" d="M174 96c-4 6-6 9-6 12a6 6 0 0 0 12 0c0-3-2-6-6-12Z" style="--i:1"/>
        <path class="gf-s-weg" d="M160 76c-4 6-6 9-6 12a6 6 0 0 0 12 0c0-3-2-6-6-12Z" style="--i:2"/>
      </g>
      <rect x="40" y="148" width="170" height="14" rx="7" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
    </svg>

  {%- when 'cip' -%}
    <svg class="gf-s gf-s-cip" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <rect x="30" y="70" width="180" height="56" rx="12" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <path d="M38 98h164" stroke="var(--gf-wald)" stroke-width="1.4" stroke-dasharray="2 3" opacity=".45"/>
      <path class="gf-s-naht" d="M38 98h164" stroke="var(--gf-wald)" stroke-width="3" pathLength="1"/>
      <g class="gf-s-zipper">
        <rect x="30" y="91" width="14" height="14" rx="3" fill="var(--gf-wald)"/>
        <path d="M37 105v14" stroke="var(--gf-wald)" stroke-width="3" stroke-linecap="round"/><circle cx="37" cy="122" r="4" fill="none" stroke="var(--gf-wald)" stroke-width="2"/>
      </g>
      <path d="M50 140h140" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round" opacity=".25"/>
    </svg>

  {%- when 'toper' -%}
    <svg class="gf-s gf-s-toper" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-auflage">
        <rect x="34" y="66" width="172" height="22" rx="10" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
        <path d="M54 77h132" stroke="var(--gf-wald)" stroke-width="1.4" stroke-dasharray="1 9" stroke-linecap="round"/>
      </g>
      <rect x="34" y="92" width="172" height="48" rx="8" fill="#2A2E2B" stroke="var(--gf-wald)" stroke-width="2"/>
      <path d="M58 98v36M68 98v36M172 98v36M182 98v36" stroke="#F5F3EC" stroke-width="2.4"/>
      <rect x="108" y="106" width="24" height="20" rx="2" fill="none" stroke="#F5F3EC" stroke-width="2"/>
    </svg>

  {%- when 'plat' -%}
    <svg class="gf-s gf-s-plat" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <defs><clipPath id="gf-plat-clip-{{ product.id }}"><rect x="40" y="30" width="160" height="120" rx="14"/></clipPath></defs>
      <rect x="40" y="30" width="160" height="120" rx="14" fill="#fff" stroke="var(--gf-wald)" stroke-width="2"/>
      <g clip-path="url(#gf-plat-clip-{{ product.id }})">
        <g fill="none" stroke="var(--gf-wald)" stroke-width="1.6" opacity=".6">
          {%- for i in (0..5) -%}
            {%- assign a = i | times: 40 | minus: 60 -%}
            <path class="gf-s-steppen" d="M{{ a }} 150l120-120" pathLength="1" style="--i:{{ i }}"/>
            <path class="gf-s-steppen" d="M{{ a | plus: 120 }} 150 {{ a }} 30" pathLength="1" style="--i:{{ i | plus: 1 }}"/>
          {%- endfor -%}
        </g>
        <g fill="var(--gf-wald)" opacity=".25">
          {%- for i in (0..3) -%}{%- for j in (0..2) -%}<circle cx="{{ i | times: 40 | plus: 60 }}" cy="{{ j | times: 40 | plus: 50 }}" r="2.4"/>{%- endfor -%}{%- endfor -%}
        </g>
        <rect class="gf-s-glanz" x="0" y="20" width="40" height="140" fill="url(#gf-plat-glanz-{{ product.id }})"/>
      </g>
      <defs><linearGradient id="gf-plat-glanz-{{ product.id }}" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".8"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient></defs>
    </svg>

  {%- when 'sezoni' -%}
    <svg class="gf-s gf-s-sezoni" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      <g class="gf-s-sonne">
        <circle cx="120" cy="52" r="15" fill="none" stroke="var(--gf-wald)" stroke-width="2.2"/>
        <path d="M120 26v-8M120 86v-8M94 52h-8M154 52h-8M102 34l-6-6M144 76l-6-6M138 34l6-6M96 76l6-6" stroke="var(--gf-wald)" stroke-width="2.2" stroke-linecap="round"/>
      </g>
      <g class="gf-s-schnee" stroke="var(--gf-wald)" stroke-width="2.2" stroke-linecap="round" fill="none">
        <path d="M120 30v44M101 41l38 22M101 63l38-22"/>
      </g>
      <path class="gf-s-welle-decke" d="M30 128c20-16 40-16 60 0s40 16 60 0 40-16 60 0v20H30Z" fill="#fff" stroke="var(--gf-wald)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M30 148h180" stroke="var(--gf-wald)" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {%- when 'sloeve' -%}
    {%- liquid
      assign quelle = product.metafields.custom.schichten.value
      if quelle == blank
        capture quelle
          render 'gf-schichten-daten', handle: product.handle
        endcapture
      endif
      assign zeilen = quelle | strip | newline_to_br | split: '<br />'
      assign schicht_text = ''
      assign summe = 0
      for zeile in zeilen
        assign z = zeile | strip
        assign f = z | split: '|'
        if f[0] == 'schicht'
          assign schicht_text = schicht_text | append: z | append: '§'
          assign anteil = f[5] | plus: 0
          if anteil < 1
            assign anteil = 3
          endif
          assign summe = summe | plus: anteil
        endif
      endfor
      assign schichten = schicht_text | split: '§'
      assign anzahl = schichten.size
      assign luft = anzahl | minus: 1 | times: 4
      assign verfuegbar = 116 | minus: luft
      assign y = 30
    -%}
    <svg class="gf-s gf-s-sloeve" viewBox="0 0 240 180" aria-hidden="true" focusable="false">
      {%- for s in schichten -%}
        {%- liquid
          assign f = s | split: '|'
          assign anteil = f[5] | plus: 0
          if anteil < 1
            assign anteil = 3
          endif
          assign h = verfuegbar | times: anteil | divided_by: summe
          if h < 10
            assign h = 10
          endif
          case f[1]
            when 'bezug'
              assign farbe = '#FBFAF6'
            when 'topper'
              assign farbe = '#FFFFFF'
            when 'wolle'
              assign farbe = '#EFE6D6'
            when 'memory'
              assign farbe = '#F3ECDC'
            when 'gel'
              assign farbe = '#3F67C2'
            when 'hr'
              assign farbe = '#B8CDB2'
            when 'kern'
              assign farbe = '#E6D6B8'
            when 'federn'
              assign farbe = '#EDEEEA'
            else
              assign farbe = '#FFFFFF'
          endcase
          assign kreis = h | divided_by: 2 | plus: y
          assign mitte = kreis | plus: 3
        -%}
        <g class="gf-s-lage" style="--i:{{ forloop.index0 }}">
          <rect x="52" y="{{ y }}" width="136" height="{{ h }}" rx="{% if h > 14 %}6{% else %}4{% endif %}" fill="{{ farbe }}" stroke="var(--gf-wald)" stroke-width="1.6"/>
          {%- if f[1] == 'federn' -%}
            {%- assign fy = y | plus: 3 -%}{%- assign fh = h | minus: 6 -%}
            <path d="M62 {{ fy }}v{{ fh }}M80 {{ fy }}v{{ fh }}M98 {{ fy }}v{{ fh }}M116 {{ fy }}v{{ fh }}M134 {{ fy }}v{{ fh }}M152 {{ fy }}v{{ fh }}M170 {{ fy }}v{{ fh }}" stroke="var(--gf-wald)" stroke-width="1.4" stroke-dasharray="3 3" opacity=".5"/>
          {%- endif -%}
          <circle cx="206" cy="{{ kreis }}" r="8" fill="var(--gf-wald)"/>
          <text x="206" y="{{ mitte }}" font-size="10" font-weight="600" font-family="Montserrat, sans-serif" fill="#fff" text-anchor="middle">{{ forloop.index }}</text>
        </g>
        {%- assign y = y | plus: h | plus: 4 -%}
      {%- endfor -%}
    </svg>
{%- endcase -%}
