{%- comment -%}
  Vorteile unter dem Kaufknopf. Nur Angaben, die auf greenfabric.bg und in den Lieferbedingungen
  stehen: 8 Jahre Garantie (nur Matratzen), Fertigung in 1 bis 3 Werktagen und Lieferung mit Speedy
  (Kosten nach Speedy-Tarif), 14 Tage Widerrufsrecht fuer Standardgroessen (Rueckgabebedingungen), Showroom, Beratung.
  Eingebunden ueber einen Block "Eigenes Liquid" in templates/product.json.
  Aufruf: {% render 'gf-produkt-vorteile', product: product %}
{%- endcomment -%}
{%- assign ist_matratze = false -%}
{%- if product.type contains 'атрак' -%}{%- assign ist_matratze = true -%}{%- endif -%}
<ul class="gf-vorteile" role="list">
  {%- if ist_matratze -%}
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.8 4.5 5.6v5.6c0 4.6 3.1 8.4 7.5 9.9 4.4-1.5 7.5-5.3 7.5-9.9V5.6L12 2.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m8.6 11.9 2.4 2.3 4.5-4.7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><strong>8 години гаранция</strong>за всеки матрак</span>
    </li>
  {%- endif -%}
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.8 6.5h11v9.7h-11zM13.8 9.6h3.9l3.5 3.6v3h-7.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6.6" cy="17.4" r="1.8" fill="var(--gf-salbei)" stroke="currentColor" stroke-width="1.5"/><circle cx="17.2" cy="17.4" r="1.8" fill="var(--gf-salbei)" stroke="currentColor" stroke-width="1.5"/></svg>
    <span><strong>Изработка за 1 до 3 работни дни</strong>после Speedy до адрес или офис</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 9.5h11a4.5 4.5 0 0 1 0 9H9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="m8 5.5-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span><strong>14 дни право на отказ</strong>{%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">за стандартните размери</a>{%- else -%}за стандартните размери{%- endif -%}</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 20.5V9.2L12 3.5l8.5 5.7v11.3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7.5 20.5v-5.3h9v5.3M2.5 20.5h19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span><strong>Пробвайте в шоурума</strong>бул. „България“ 49A, София</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 3.5h3l1.5 4-2 1.3a10.5 10.5 0 0 0 6.1 6.1l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <span><strong>Помощ при избора</strong><a href="tel:+359885502222">+359 885 502 222</a></span>
  </li>
</ul>
