{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "dropdown",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Споделете"
          }
        },
        "gf_vorteile": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'gf-produkt-vorteile', product: product %}"
          }
        },
        "gf_kurz": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'gf-story-kurz', product: product %}"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "gf_kurz",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "gf_vorteile",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Може да харесате също",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "gf_schichten": {
      "type": "gf-schichten",
      "settings": {}
    },
    "gf_beratung": {
      "type": "gf-beratung",
      "settings": {
        "karte": true,
        "index": "Консултация",
        "titel1": "Нуждаете се от помощ",
        "titel2": "при избора?",
        "text": "Разкажете ни как спите. Ще ви помогнем да намерите подходящия матрак, а в шоурума ни в София можете да го пробвате.",
        "knopf1_text": "Свържете се с нас",
        "knopf1_link": "shopify://pages/contact",
        "knopf2_text": "Всички матраци",
        "knopf2_link": "shopify://collections/matraci",
        "datei": "gf-beratung.jpg"
      }
    },
    "gf_geschichte": {
      "type": "gf-geschichte",
      "settings": {}
    },
    "gf_serien": {
      "type": "gf-kollektionen",
      "settings": {}
    }
  },
  "order": [
    "main",
    "gf_geschichte",
    "gf_schichten",
    "related-products",
    "gf_serien",
    "disclosures",
    "gf_beratung"
  ]
}
