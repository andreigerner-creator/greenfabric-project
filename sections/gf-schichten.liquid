{%- comment -%}
  GF Schichten: Aufbau der Matratze als 3D Explosionsansicht unter der Produktgalerie.
  Die Schichten stehen in snippets/gf-schichten-daten.liquid (je Handle) oder im Metafeld
  custom.schichten. Ohne Angaben bleibt die Sektion leer.
  Beim Scrollen heben sich die Schichten voneinander ab (--auf 0 bis 1, gf-produkt.js),
  Ohne JavaScript und bei "Bewegung reduzieren" steht der Stapel auseinandergezogen da.
{%- endcomment -%}
{%- liquid
  assign quelle = product.metafields.custom.schichten.value
  if quelle == blank
    capture quelle
      render 'gf-schichten-daten', handle: product.handle
    endcapture
  endif
  assign quelle = quelle | strip

  assign gesamt = ''
  assign oben = ''
  assign unten = ''
  assign schicht_text = ''
  assign notiz_text = ''
  assign summe = 0
  assign anzahl = 0

  assign zeilen = quelle | newline_to_br | split: '<br />'
  for zeile in zeilen
    assign z = zeile | strip
    assign f = z | split: '|'
    case f[0]
      when 'gesamt'
        assign gesamt = f[1] | strip
      when 'oben'
        assign oben = f[1] | strip
      when 'unten'
        assign unten = f[1] | strip
      when 'notiz'
        assign notiz_text = notiz_text | append: f[1] | append: '§'
      when 'schicht'
        assign schicht_text = schicht_text | append: z | append: '§'
        assign anteil = f[5] | plus: 0
        if anteil < 1
          assign anteil = 3
        endif
        assign summe = summe | plus: anteil
        assign anzahl = anzahl | plus: 1
    endcase
  endfor

  assign schichten = schicht_text | split: '§'
  assign notizen = notiz_text | split: '§'
  assign zwei_seiten = false
  if oben != blank and unten != blank
    assign zwei_seiten = true
  endif
-%}

{%- if anzahl > 0 -%}
  <div
    class="gf-schichten color-{{ section.settings.color_scheme }}"
    data-gf-schichten
    style="--anzahl: {{ anzahl }}; --summe: {{ summe }};"
  >
    <div class="gf-breite gf-schichten-raster">
      <div class="gf-schichten-text">
        {%- if section.settings.index != blank -%}
          <p class="gf-index gf-index-dunkel" data-einblenden>{{ section.settings.index }}</p>
        {%- endif -%}
        <h2 class="gf-titel" data-einblenden>
          {{- section.settings.titel -}}
          {%- if section.settings.titel_mit_name -%}
            <span class="gf-zeile-block gf-schichten-name">{{ product.title | remove: 'Двулицев матрак с пружини' | remove: 'Двулицев матрак' | remove: 'Бебешки матрак' | strip }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="gf-text gf-schichten-einleitung" data-einblenden>{{ section.settings.text }}</p>
        {%- endif -%}

        <ol class="gf-schichten-liste" role="list">
          {%- for s in schichten -%}
            {%- assign f = s | split: '|' -%}
            <li class="gf-schichten-punkt" data-lage="{{ forloop.index0 }}" tabindex="0" data-einblenden>
              <span class="gf-schichten-nr">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="gf-schichten-probe gf-art-{{ f[1] | strip }}" aria-hidden="true"></span>
              <span class="gf-schichten-inhalt">
                <span class="gf-schichten-titel">
                  {{- f[2] | strip -}}
                  {%- assign cm = f[4] | strip -%}
                  {%- if cm != blank %} <span class="gf-schichten-cm">{{ cm }} см</span>{% endif -%}
                </span>
                {%- assign t = f[3] | strip -%}
                {%- if t != blank -%}<span class="gf-schichten-beschreibung">{{ t }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>

        {%- if notiz_text != blank -%}
          <ul class="gf-schichten-notizen" role="list">
            {%- for n in notizen -%}
              {%- if n != blank -%}<li data-einblenden>{{ n | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="gf-schichten-buehne" data-einblenden="zoom">
        {%- if zwei_seiten -%}
          <p class="gf-schichten-seite gf-schichten-seite-oben">
            <span class="gf-schichten-seite-a">{{ oben }}</span><span class="gf-schichten-seite-b">{{ unten }}</span>
          </p>
        {%- endif -%}

        <div class="gf-schichten-raum" aria-hidden="true">
          <div class="gf-schichten-szene">
            <div class="gf-schichten-stapel">
              {%- assign darueber = 0 -%}
              {%- for s in schichten -%}
                {%- liquid
                  assign f = s | split: '|'
                  assign anteil = f[5] | plus: 0
                  if anteil < 1
                    assign anteil = 3
                  endif
                  assign darunter = summe | minus: darueber | minus: anteil
                  assign von_unten = anzahl | minus: forloop.index
                  assign darueber = darueber | plus: anteil
                -%}
                <div
                  class="gf-lage gf-art-{{ f[1] | strip }}"
                  data-lage="{{ forloop.index0 }}"
                  style="--h: {{ anteil }}; --unter: {{ darunter }}; --j: {{ von_unten }};"
                >
                  <span class="gf-f gf-f-oben"><span class="gf-f-nr">{{ forloop.index }}</span></span>
                  <span class="gf-f gf-f-unten"></span>
                  <span class="gf-f gf-f-vorne"></span>
                  <span class="gf-f gf-f-hinten"></span>
                  <span class="gf-f gf-f-links"></span>
                  <span class="gf-f gf-f-rechts"></span>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>

        {%- if zwei_seiten -%}
          <p class="gf-schichten-seite gf-schichten-seite-unten">
            <span class="gf-schichten-seite-a">{{ unten }}</span><span class="gf-schichten-seite-b">{{ oben }}</span>
          </p>
        {%- endif -%}

        <div class="gf-schichten-leiste">
          {%- if gesamt != blank -%}
            <p class="gf-schichten-hoehe">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1v14M4.5 4.5 8 1l3.5 3.5M4.5 11.5 8 15l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ section.settings.hoehe_text }} {{ gesamt }} см
            </p>
          {%- endif -%}
          {%- if zwei_seiten -%}
            <button type="button" class="gf-schichten-wenden" data-gf-wenden hidden aria-pressed="false">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M13.5 6A5.6 5.6 0 0 0 3 4.4M2.5 10A5.6 5.6 0 0 0 13 11.6M3 1.5v3h3M13 14.5v-3h-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ section.settings.wenden_text }}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="gf-breite gf-schichten-leer">
    <p>GF Schichten: für dieses Produkt ist noch kein Aufbau hinterlegt (snippets/gf-schichten-daten.liquid oder Metafeld custom.schichten).</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "GF Schichten",
  "tag": "section",
  "class": "gf-sektion",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Zeigt den Aufbau der Matratze als 3D Ansicht. Die Schichten kommen aus dem Metafeld custom.schichten oder aus snippets/gf-schichten-daten.liquid."
    },
    {
      "type": "text",
      "id": "index",
      "label": "Kleine Zeile über dem Titel",
      "default": "Какво има вътре"
    },
    {
      "type": "text",
      "id": "titel",
      "label": "Titel",
      "default": "Слой по слой:"
    },
    {
      "type": "checkbox",
      "id": "titel_mit_name",
      "label": "Modellnamen unter den Titel setzen",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Превъртете надолу и вижте как е изграден матракът. Посочете слой, за да научите повече за него."
    },
    {
      "type": "text",
      "id": "hoehe_text",
      "label": "Text vor der Gesamthöhe",
      "default": "Обща височина"
    },
    {
      "type": "text",
      "id": "wenden_text",
      "label": "Knopf zum Wenden",
      "default": "Обърнете матрака"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
