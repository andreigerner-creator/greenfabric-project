{%- comment -%}
  Greenfabric Einstieg in die Auswahl: drei oder vier ruhige Karten, wahlweise mit Bild, direkt unter dem Hero (Brand Guidelines
  v1.0, Startseite: "Einstieg in die Auswahl"), z. B. Groesse, Komfort vergleichen, Beratung.
  Karten blenden gestaffelt ein. Aussehen: gf-signatur.css, Abschnitt "Einstieg".
{%- endcomment -%}
<section class="gf-einstieg-abschnitt">
  <div class="gf-breite">
    {%- if section.settings.titel != blank -%}
      <h2 class="gf-titel" data-einblenden>{{ section.settings.titel }}</h2>
    {%- endif -%}
    <ul class="gf-einstieg" style="--anzahl: {{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <li data-einblenden style="--verzoegerung: {{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          <a class="gf-einstieg-karte{% if block.settings.bild != blank or block.settings.datei != blank %} gf-einstieg-karte-bild{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            {%- if block.settings.bild != blank or block.settings.datei != blank -%}
              <span class="gf-einstieg-foto">
                {%- render 'gf-bild', bild: block.settings.bild, datei: block.settings.datei, alt: block.settings.titel, breiten: '400, 600, 900, 1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', verhaeltnis: 1 -%}
              </span>
            {%- endif -%}
            <strong>{{ block.settings.titel }}</strong>
            <span>{{ block.settings.text }}</span>
            {% render 'gf-pfeil' %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "GF Einstieg",
  "tag": "div",
  "class": "gf-sektion",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "titel", "label": "Titel (optional)" }
  ],
  "blocks": [
    {
      "type": "karte",
      "name": "Karte",
      "settings": [
        { "type": "text", "id": "titel", "label": "Titel", "default": "Изберете размер" },
        { "type": "text", "id": "text", "label": "Text", "default": "Открийте подходящите модели." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "bild", "label": "Bild (optional)" },
        { "type": "text", "id": "datei", "label": "Standardbild aus dem Theme (optional)", "info": "z. B. gf-kategorie-matratzen.jpg, wird gezeigt, solange kein eigenes Bild gewählt ist" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GF Einstieg",
      "blocks": [
        { "type": "karte", "settings": { "titel": "Изберете размер", "text": "Открийте подходящите модели." } },
        { "type": "karte", "settings": { "titel": "Сравнете комфорта", "text": "Вижте разликите между тях." } },
        { "type": "karte", "settings": { "titel": "Попитайте ни", "text": "Ще ви помогнем при избора." } }
      ]
    }
  ]
}
{% endschema %}
